[Unit]
Description=Ceefax Station hourly AX.25 audio
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
# Packaged install (Debian/Ubuntu). For a git checkout, use:
#   ExecStart=/usr/bin/python3 -m ceefaxstation tx hourly --refresh-lead 300 --carousel-loops 3 --play --play-loops 1
#   WorkingDirectory=/path/to/ceefax_station
ExecStart=/usr/bin/ceefaxstation tx hourly --refresh-lead 300 --carousel-loops 3 --play --play-loops 1
Restart=on-failure
Environment=CEEFAX_PACKAGED=1

[Install]
WantedBy=default.target
